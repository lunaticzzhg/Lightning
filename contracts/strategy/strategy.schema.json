{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lightning strategy manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_version",
    "name",
    "description",
    "markets",
    "bar_interval",
    "required_fields",
    "entrypoint",
    "python",
    "dependencies",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interface_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CN",
          "US"
        ]
      }
    },
    "bar_interval": {
      "type": "string",
      "pattern": "^[1-9][0-9]*m$"
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      }
    },
    "entrypoint": {
      "const": "strategy:on_bar"
    },
    "python": {
      "const": "3.13"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "integer",
            "number",
            "boolean",
            "string",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
