  "components": {
    "schemas": {
      "Strategy": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version_count",
          "latest_version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version_count": {
            "type": "integer"
          },
          "latest_version": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "id",
          "strategy_id",
          "number",
          "file_name",
          "uploaded_at",
          "sha256",
          "manifest",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "strategy_id": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "file_name": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "manifest": {
            "type": "object",
            "additionalProperties": true
          },
          "status": {
            "type": "string"
          }
        }
      },
      "StrategyDetail": {
        "type": "object",
        "required": [
          "strategy",
          "versions"
        ],
        "properties": {
          "strategy": {
            "$ref": "#/components/schemas/Strategy"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          }
        }
      },
      "VersionDetail": {
        "type": "object",
        "required": [
          "version",
          "strategy"
        ],
        "properties": {
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "strategy": {
            "$ref": "#/components/schemas/Strategy"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "ok",
          "token"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "token": {
            "type": "string"
          }
        }
      }
    }
  }
}
